# DS203 HW 2.6x, iCE65L04 VQ100 pin numbers
# (from github.com/PetteriAimonen/dso-quad-logic, branch fpga_support)

set_io clk 15

set_io fsmc_ce 27
set_io fsmc_nwr 28
set_io fsmc_nrd 29
set_io fsmc_db[15] 36
set_io fsmc_db[14] 37
set_io fsmc_db[13] 40
set_io fsmc_db[11] 41
set_io fsmc_db[12] 42
set_io fsmc_db[10] 51
set_io fsmc_db[9] 52
set_io fsmc_db[8] 53
set_io fsmc_db[7] 54
set_io fsmc_db[6] 56
set_io fsmc_db[5] 57
set_io fsmc_db[4] 59
set_io fsmc_db[3] 20
set_io fsmc_db[2] 30
set_io fsmc_db[1] 33
set_io fsmc_db[0] 34

set_io chc_din 24
set_io chd_din 25

set_io adc_sleep 2
set_io cha_clk 81
set_io chb_clk 100
