-    int gbs_available = 8, resets_available = 4, cens_available = 4;
+    // Count the global buffers this device really offers. Even-numbered networks can drive
+    // resets, odd-numbered ones clock enables (8/4/4 on all regular iCE40 parts).
+    int gbs_available = 0, resets_available = 0, cens_available = 0;
+    for (auto bel : ctx->getBels()) {
+        if (ctx->getBelType(bel) != id_SB_GB)
+            continue;
+        if (ctx->getBelPinWire(bel, id_USER_SIGNAL_TO_GLOBAL_BUFFER) == WireId())
+            continue; // pad-only buffer
+        ++gbs_available;
+        if ((ctx->get_driven_glb_netwk(bel) % 2) == 0)
+            ++resets_available;
+        else
+            ++cens_available;
+    }
+    if (gbs_available < 8) {
+        // Few buffers (iCE65 L04 with only the confirmed networks): keep them for clocks
+        resets_available = 0;
+        cens_available = 0;
+    }
     for (auto &cell : ctx->cells)
         if (is_gbuf(ctx, cell.second.get())) {
+            /* A buffer standing in for a clock pad on a pad-only location takes nothing away */
+            if (cell.second->attrs.count(id_BEL)) {
+                BelId fixed = ctx->getBelByNameStr(cell.second->attrs[id_BEL].as_string());
+                if (ctx->getBelPinWire(fixed, id_USER_SIGNAL_TO_GLOBAL_BUFFER) == WireId())
+                    continue;
+            }
             /* One less buffer available */
             --gbs_available;
 
